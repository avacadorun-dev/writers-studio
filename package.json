{
  "name": "writers-studio",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:search": "bun run ./scripts/build-docs-search.ts",
    "docs:check": "bun run ./scripts/check-docs.ts",
    "dev": "bun run docs:search && vite --host 0.0.0.0",
    "build": "bun run docs:search && vite build && tsc -b --pretty false",
    "check": "bun run docs:check && biome check .",
    "check:fix": "biome check --write .",
    "type-check": "tsc -b --pretty false",
    "test": "bun test ./src/",
    "test:coverage": "bun test ./src/ --coverage",
    "test:code-block:coverage": "bun test ./src/features/editor/model/code-block.test.ts ./src/features/editor/model/code-block-ui.test.tsx ./src/features/editor/model/extensions.test.ts --coverage && bun run ./scripts/verify-code-block-coverage.ts",
    "test:rich-blocks:coverage": "bun run test:code-block:coverage && bun run ./scripts/verify-rich-block-coverage.ts",
    "test:canvas:coverage": "bun test ./src/entities/canvas ./src/features/canvas-autosave ./src/shared/lib/recovery-db.test.ts --coverage && bun run ./scripts/verify-canvas-coverage.ts",
    "e2e": "playwright test",
    "e2e:compose": "bash ./scripts/e2e-compose.sh",
    "e2e:real-stt": "playwright test -c playwright.real-stt.config.ts",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/philosopher": "^5.3.0",
    "@fontsource/sofia-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@orama/orama": "3.1.18",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-router": "^1.131.35",
    "@tiptap/core": "^3.2.2",
    "@tiptap/extension-link": "^3.2.2",
    "@tiptap/extension-placeholder": "^3.2.2",
    "@tiptap/extension-table": "^3.2.2",
    "@tiptap/extension-underline": "^3.2.2",
    "@tiptap/pm": "^3.2.2",
    "@tiptap/react": "^3.2.2",
    "@tiptap/starter-kit": "^3.2.2",
    "@types/mdx": "2.0.13",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.0",
    "fumadocs-core": "16.12.1",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.12.1",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "katex": "^0.18.4",
    "lucide-react": "^0.542.0",
    "mermaid": "^11.12.0",
    "pdfjs-dist": "^6.2.108",
    "perfect-freehand": "^1.2.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "refractor": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "swagger-ui-dist": "5.32.12",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "^2.2.2",
    "@drawio/mcp": "1.5.0",
    "@happy-dom/global-registrator": "^18.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/router-plugin": "^1.131.35",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.10",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3"
  }
}
