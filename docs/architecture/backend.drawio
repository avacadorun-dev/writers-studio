        <mxCell id="flow1" value="1. Dictation live&#xa;Browser WS → httpapi RTG → stt.Deepgram → events back&#xa;chunks → objectstore; session state → store" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="flow">
