# Explicit retranscription and emergency fallback use OpenRouter when
# STT_ADAPTER=auto and this key is present. A successful Deepgram session is not
# sent to OpenRouter automatically.
# Live dictation uses Deepgram when LIVE_STT_ADAPTER=auto and this key is present.
# Leave both empty to disable speech recognition explicitly. Canned test adapters
# are only available through docker-compose.e2e.yml with a separate safety gate.
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=

# Server/runtime
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://writers:writers@localhost:5432/writers_studio?sslmode=disable
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=writers
OBJECT_STORAGE_SECRET_KEY=writers-secret
OBJECT_STORAGE_BUCKET=writers-studio
OBJECT_STORAGE_USE_SSL=false
ALLOW_TEST_ADAPTERS=false
STT_ADAPTER=auto
LIVE_STT_ADAPTER=auto
OPENROUTER_STT_MODEL=openai/whisper-large-v3
DEEPGRAM_STT_MODEL=nova-3

# Assistant system model. OpenAI-compatible providers can use either the
# Responses API or Chat Completions. User-provided credentials are encrypted
# with a separate 32-byte base64 key.
LLM_ADAPTER=auto
LLM_BASE_URL=
LLM_API_KEY=
# Required when LLM_BASE_URL and LLM_API_KEY are set. Use the exact model ID
# exposed by that provider; Writer's Studio never guesses across providers.
LLM_MODEL=
LLM_DIALECT=chat_completions
LLM_CREDENTIAL_ENCRYPTION_KEY=
LLM_ALLOW_PRIVATE_ENDPOINTS=false
LLM_REQUEST_TIMEOUT=10m
PUBLIC_BASE_URL=http://localhost:8080

# Remote MCP is opt-in. Generate a separate random secret; do not reuse the
# session or LLM credential key. The MCP endpoint is PUBLIC_BASE_URL/mcp.
MCP_ENABLED=false
MCP_OAUTH_SECRET=
