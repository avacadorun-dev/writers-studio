# Set the image reference supplied by your release publisher, including a version
# tag or immutable digest. No official registry is configured by this template.
WRITERS_STUDIO_IMAGE=
APP_PORT=8080

# Use URL-safe values here: letters, digits, hyphens and underscores only.
# Do not reuse these values between installations.
POSTGRES_DB=writers_studio
POSTGRES_USER=writers
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_VALUE
OBJECT_STORAGE_ACCESS_KEY=writers
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_URL_SAFE_VALUE
OBJECT_STORAGE_BUCKET=writers-studio

# Leave both keys empty to run without speech recognition. Use your own provider
# keys; never distribute them in an installation bundle or container image.
STT_ADAPTER=auto
LIVE_STT_ADAPTER=auto
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=openai/whisper-large-v3
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3

# System Assistant provider (optional). If a user will save provider keys in
# the application, generate and keep a 32-byte base64 key here, for example:
# openssl rand -base64 32
LLM_ADAPTER=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DIALECT=chat_completions
LLM_CREDENTIAL_ENCRYPTION_KEY=
LLM_ALLOW_PRIVATE_ENDPOINTS=false
LLM_REQUEST_TIMEOUT=10m
